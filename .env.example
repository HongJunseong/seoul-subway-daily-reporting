# 로컬 합성 데모는 인증 정보가 필요하지 않습니다.
# 실제 실행에는 환경변수 주입 또는 Compose env_file을 사용합니다.

# 서울시 원천 수집
SEOUL_ARRIVAL_API_KEY=
SEOUL_PASSENGER_API_KEY=

# S3 저장소 (로컬 재처리에는 불필요)
SSDR_S3_BUCKET=
SSDR_STORAGE_PREFIX=v2
SSDR_AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
# AWS profile/역할을 사용하면 아래 값은 비워둡니다. 임시 키에는 session token도 필요합니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# LLM 보고서: 실제 생성은 llm, 키 없는 재현은 template
SSDR_REPORT_MODE=template
OPENAI_API_KEY=
SSDR_LLM_MODEL=gpt-5-mini

# 선택적 Slack 알림 (비워두면 전송하지 않음)
SLACK_WEBHOOK_URL=

# Linux Compose 실행 계정 / 로컬 웹 세션
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_SECRET_KEY=
