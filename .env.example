# Local replay/demo does not need keys. Runtime jobs read environment variables.
SSDR_S3_BUCKET=
SSDR_STORAGE_PREFIX=v2
AWS_DEFAULT_REGION=ap-northeast-2
SSDR_AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SEOUL_ARRIVAL_API_KEY=
SEOUL_PASSENGER_API_KEY=

# Optional external notifications and AI commentary
SLACK_WEBHOOK_URL=
SSDR_REPORT_MODE=template
OPENAI_API_KEY=
SSDR_LLM_MODEL=gpt-5-mini

# Linux Compose ownership / local development secret
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_SECRET_KEY=
